---
/*
 * Layout base de todas las páginas: <head>, enlace "Saltar al contenido",
 * cartel de navegación, contenido, footer y menú.
 */
import '../styles/fonts.css';
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/typography.css';

// Fuentes del hero: se precargan para que el titular no espere al CSS.
// ?url devuelve la ruta final del archivo (con la base y el hash).
import yellowtail from '@fontsource/yellowtail/files/yellowtail-latin-400-normal.woff2?url';
import josefinSans from '@fontsource-variable/josefin-sans/files/josefin-sans-latin-wght-normal.woff2?url';

import Navegacion from '../components/Navegacion.astro';
import Menu from '../components/Menu.astro';
import Pie from '../components/Pie.astro';
import {
  idiomaPorDefecto,
  idiomas,
  traductor,
  type Idioma,
} from '../lib/i18n.ts';
import { rutaEnIdioma, type Pagina } from '../lib/rutas.ts';
import { claveTema, temas } from '../lib/tema.ts';
import { claveMoneda, monedas } from '../lib/moneda.ts';

interface Props {
  idioma?: Idioma;
  /** Título de la pestaña. Por defecto, el de la portada. */
  titulo?: string;
  descripcion?: string;
  /** Página actual, para marcar su enlace en la navegación. */
  pagina?: Pagina;
}

const { idioma = idiomaPorDefecto, pagina } = Astro.props;
const t = traductor(idioma);
const titulo = Astro.props.titulo ?? t('meta.titulo');
const descripcion = Astro.props.descripcion ?? t('meta.descripcion');

/*
 * La misma página en cada idioma, con URL completa: <link rel="alternate"
 * hreflang> es el estándar para que los buscadores enseñen a cada cual la
 * versión de su idioma. x-default es la que se da si no coincide ninguno.
 */
const alternativas = [
  ...idiomas.map((i) => ({ hreflang: i, idioma: i })),
  { hreflang: 'x-default', idioma: idiomaPorDefecto },
].map(({ hreflang, idioma: i }) => ({
  hreflang,
  href: new URL(rutaEnIdioma(Astro.url.pathname, i), Astro.site).href,
}));

const preloads = [yellowtail, josefinSans];

// Preferencias guardadas que el script del <head> pone en <html>
const preferencias = [
  { clave: claveTema, valores: temas, atributo: 'theme' },
  { clave: claveMoneda, valores: monedas, atributo: 'moneda' },
];
---

<!doctype html>
<html lang={idioma}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/*
      La página sabe pintarse en los dos modos: el navegador elige el fondo
      y los controles nativos según el sistema antes de que llegue el CSS.
      El color-scheme de tokens.css lo ajusta después al modo elegido.
    */}
    <meta name="color-scheme" content="light dark" />
    {/*
      Modo y moneda elegidos con los interruptores (src/lib/tema.ts y
      src/lib/moneda.ts). Va en línea y antes del CSS para que se aplique
      antes de pintar: si esperase a los scripts de los selectores, la
      página saldría un instante en el modo del sistema y en francos (el
      parpadeo al cargar).
    */}
    <script is:inline define:vars={{ preferencias }}>
      try {
        for (const { clave, valores, atributo } of preferencias) {
          const valor = localStorage.getItem(clave);
          if (valores.includes(valor)) {
            document.documentElement.dataset[atributo] = valor;
          }
        }
      } catch {
        // Sin almacenamiento: modo del sistema y francos
      }
    </script>
    {preloads.map((href) => (
      <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />
    ))}
    <title>{titulo}</title>
    <meta name="description" content={descripcion} />
    {alternativas.map(({ hreflang, href }) => (
      <link rel="alternate" hreflang={hreflang} href={href} />
    ))}
  </head>
  <body>
    <a class="saltar text-boton" href="#contenido">
      {t('nav.saltarAlContenido')}
    </a>
    <Navegacion idioma={idioma} pagina={pagina} />
    <main id="contenido">
      <slot />
    </main>
    <Pie idioma={idioma} pagina={pagina} />
    <Menu idioma={idioma} pagina={pagina} />
  </body>
</html>

<style>
  body {
    display: flex;
    flex-direction: column;
  }

  main {
    flex-grow: 1;
  }

  /*
   * "Saltar al contenido": el primer enlace de la página. Queda fuera de
   * la pantalla y baja al recibir el foco con el teclado, para saltarse
   * la navegación (WCAG 2.4.1).
   */
  .saltar {
    position: fixed;
    inset-block-start: var(--space-12);
    inset-inline-start: var(--space-12);
    z-index: 20;
    padding: var(--space-16) var(--space-24);
    border-radius: var(--radius-pill);
    background-color: var(--color-bg-inverse);
    color: var(--color-text-on-inverse);
    text-decoration: none;
    transform: translateY(-200%);
  }

  .saltar:focus {
    transform: none;
  }
</style>
