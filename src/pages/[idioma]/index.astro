---
/*
 * Portada en cada idioma: /es/ y /en/. getStaticPaths genera una página
 * por idioma a partir del mismo archivo, así las dos son siempre iguales.
 *
 * Contenido provisional: el texto del hero. Se sustituye por el descenso
 * (Fase 3). El muestrario de componentes está en el catálogo
 * (/componentes/).
 */
import type { GetStaticPaths } from 'astro';
import Base from '../../layouts/Base.astro';
import { idiomas, traductor, type Idioma } from '../../lib/i18n.ts';

export const getStaticPaths = (() =>
  idiomas.map((idioma) => ({ params: { idioma } }))) satisfies GetStaticPaths;

const idioma = Astro.params.idioma as Idioma;
const t = traductor(idioma);
---

<Base idioma={idioma} titulo={t('meta.titulos.inicio')} pagina="inicio">
  <div class="provisional">
    <p class="antetitulo text-etiqueta-antetitulo">
      {t('inicio.hero.antetitulo')}
    </p>
    <h1 class="titulo text-display-xl">{t('inicio.hero.titulo')}</h1>
    <p class="text-cuerpo-base">{t('inicio.hero.texto')}</p>
  </div>
</Base>

<style>
  .provisional {
    display: grid;
    gap: var(--space-24);
    max-inline-size: var(--ancho-contenido);
    padding: var(--space-96) var(--margen-pagina);
  }

  .provisional p,
  .provisional h1 {
    margin: 0;
  }

  .antetitulo,
  .titulo {
    color: var(--color-text-accent);
  }
</style>
