---
/*
 * Botón − / + de 44 × 44 px para días y personas (Figma: Componentes
 * básicos › Botón cantidad). Se deshabilita cuando el valor
 * está en su mínimo o en su máximo.
 *
 * El signo es solo visual (aria-hidden); lo que se anuncia es la etiqueta,
 * que dice qué hace: "Un día más", "Quitar: Adulto".
 *
 * Para deshabilitarlo vale disabled o aria-disabled="true", con el mismo
 * aspecto. Mejor aria-disabled: con disabled el botón deja de recibir el
 * foco, y quien baja los días con el teclado hasta el mínimo pierde el
 * foco justo al llegar. Con aria-disabled, el script ignora el clic.
 */
import type { HTMLAttributes } from 'astro/types';

type Props = Omit<HTMLAttributes<'button'>, 'type'> & {
  accion: 'menos' | 'mas';
  /** Nombre accesible del botón. */
  etiqueta: string;
};

const { accion, etiqueta, class: clase, ...resto } = Astro.props;
// U+2212, el signo menos tipográfico, no el guion
const signo = accion === 'mas' ? '+' : '−';
---

<button
  type="button"
  class:list={['cantidad', clase]}
  aria-label={etiqueta}
  {...resto}
>
  <span class="text-dato-medio" aria-hidden="true">
    {signo}
  </span>
</button>

<style>
  .cantidad {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    inline-size: var(--touch-min);
    block-size: var(--touch-min);
    padding: 0;
    border: var(--border-thin) solid var(--color-border-strong);
    border-radius: var(--radius-pill);
    background-color: transparent;
    color: var(--color-text-primary);
    cursor: pointer;
  }

  .cantidad:not(:disabled, [aria-disabled='true']):hover {
    background-color: var(--color-bg-subtle);
  }

  /* En Figma el anillo ocupa el sitio del borde: el botón sigue en 44 px */
  .cantidad:focus-visible {
    outline-offset: calc(-1 * var(--border-thick));
  }

  .cantidad:is(:disabled, [aria-disabled='true']) {
    border-color: var(--color-border-subtle);
    color: var(--color-text-disabled);
    cursor: not-allowed;
  }
</style>
