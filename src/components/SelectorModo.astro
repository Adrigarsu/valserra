---
/*
 * Selector de modo día y noche (Figma: Alta fidelidad › Home, 07 · Footer,
 * fila Modo, y Estados y piezas › Menú móvil abierto).
 *
 * Por defecto manda la preferencia del sistema; al elegir un modo se
 * guarda y se pone data-theme en <html> (src/lib/tema.ts).
 */
import AjusteRadio from './AjusteRadio.astro';
import { traductor, type Idioma } from '../lib/i18n.ts';
import { temas } from '../lib/tema.ts';

interface Props {
  idioma: Idioma;
  /** id de la etiqueta "Modo"; distinto en cada sitio donde se usa. */
  id: string;
}

const { idioma, id } = Astro.props;
const t = traductor(idioma);

const opciones = temas.map((tema) => ({
  valor: tema,
  texto: tema === 'light' ? t('ajustes.dia') : t('ajustes.noche'),
}));
---

<AjusteRadio
  id={id}
  etiqueta={t('ajustes.modo')}
  ajuste="modo"
  opciones={opciones}
/>

<script>
  import { guardar, leer } from '../lib/almacen.ts';
  import { claveTema, temas, type Tema } from '../lib/tema.ts';

  const sistemaNoche = window.matchMedia('(prefers-color-scheme: dark)');
  const raiz = document.documentElement;

  /** El modo que se ve: el elegido o, si no hay, el del sistema. */
  function temaActual(): Tema {
    const elegido = temas.find((t) => t === raiz.dataset.theme);
    return elegido ?? (sistemaNoche.matches ? 'dark' : 'light');
  }

  const selectores = document.querySelectorAll<HTMLElement>(
    '[data-ajuste="modo"]',
  );
  const radios = [...selectores].flatMap((s) => [
    ...s.querySelectorAll<HTMLInputElement>('input[type="radio"]'),
  ]);

  // Los selectores del menú y del footer marcan siempre lo mismo
  function marcar(): void {
    const tema = temaActual();
    for (const radio of radios) radio.checked = radio.value === tema;
  }

  for (const radio of radios) {
    radio.addEventListener('change', () => {
      const tema = temas.find((t) => t === radio.value);
      if (!tema) return;
      raiz.dataset.theme = tema;
      guardar(claveTema, tema);
      marcar();
    });
  }

  // Si nadie ha elegido, el selector sigue al sistema cuando este cambia
  sistemaNoche.addEventListener('change', () => {
    if (!leer(claveTema, temas)) marcar();
  });

  // Otra pestaña ha cambiado el modo: se aplica también en esta
  window.addEventListener('storage', (cambio) => {
    if (cambio.key !== claveTema) return;
    const tema = leer(claveTema, temas);
    if (tema) raiz.dataset.theme = tema;
    else delete raiz.dataset.theme;
    marcar();
  });

  marcar();
  for (const selector of selectores) selector.hidden = false;
</script>
