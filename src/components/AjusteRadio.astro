---
/*
 * Fila de ajuste con un Interruptor de radios (tipo="radio"). La usan
 * SelectorModo y SelectorMoneda, que ponen el script que lee y guarda su
 * ajuste.
 *
 * El HTML sale sin ninguna opción marcada y oculto (hidden), porque al
 * generar la página no se sabe qué ha elegido cada persona: el script del
 * selector marca la opción buena y quita hidden al cargar. Sin JavaScript
 * no se ve, porque tampoco funcionaría.
 */
import Interruptor from './Interruptor.astro';

interface Opcion {
  valor: string;
  /** Lo que se ve en el segmento. */
  texto: string;
  /** Nombre para el lector de pantalla, si lo que se ve es una abreviatura. */
  nombre?: string;
}

interface Props {
  /** id de la etiqueta; también es el name de los radios. */
  id: string;
  etiqueta: string;
  /** Qué ajuste es: el script del selector lo busca con [data-ajuste]. */
  ajuste: string;
  opciones: readonly Opcion[];
}

const { id, etiqueta, ajuste, opciones } = Astro.props;
---

<div class="ajuste" data-ajuste={ajuste} hidden>
  <span class="ajuste__nombre text-etiqueta-pequena" id={id}>
    {etiqueta}
  </span>
  <Interruptor tipo="radio" name={id} etiquetadoPor={id} opciones={opciones} />
</div>

<style>
  .ajuste {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-24);
  }

  /* hidden pierde ante display: flex si no se repite aquí */
  .ajuste[hidden] {
    display: none;
  }
</style>
