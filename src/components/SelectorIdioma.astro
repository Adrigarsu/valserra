---
/*
 * Selector de idioma (Figma: Estados y piezas › Menú móvil abierto, fila
 * Idioma, y Alta fidelidad › Home, 07 · Footer). Es un Interruptor de
 * enlaces: cambiar de idioma es navegar a la misma página en otra URL.
 * El idioma actual lleva aria-current="page", y cada enlace lleva lang y
 * hreflang para que el lector de pantalla pronuncie "English" en inglés.
 *
 * Se ve "ES" y "EN", pero el nombre accesible es el idioma completo en su
 * propia lengua ("Español", "English"), que empieza igual que lo que se ve.
 */
import Interruptor from './Interruptor.astro';
import { idiomas, nombresIdioma, traductor, type Idioma } from '../lib/i18n.ts';
import { rutaEnIdioma } from '../lib/rutas.ts';

interface Props {
  idioma: Idioma;
  /** id de la etiqueta "Idioma"; distinto en cada sitio donde se usa. */
  id: string;
}

const { idioma, id } = Astro.props;
const t = traductor(idioma);

const opciones = idiomas.map((i) => ({
  texto: i,
  nombre: nombresIdioma[i],
  href: rutaEnIdioma(Astro.url.pathname, i),
  idioma: i,
  actual: i === idioma,
}));
---

<div class="ajuste">
  <span class="ajuste__nombre text-etiqueta-pequena" id={id}>
    {t('ajustes.idioma')}
  </span>
  <Interruptor tipo="enlace" etiquetadoPor={id} opciones={opciones} />
</div>

<style>
  .ajuste {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-24);
  }
</style>
